{% extends 'base.html.twig' %}
{% set ld_flags = constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG') %}
{% set seo_desc = new.description|seo_text|seo_truncate(155) %}
{% set seo_image = new.image ? 'https://www.adivec.fr/uploads/images/blog/' ~ new.image : 'https://www.adivec.fr/img/logo_adivec.png' %}
{# Titres d'actualités parfois très longs (jusqu'à ~120 caractères) : coupés au mot pour la balise <title> #}
{% set seo_title = new.title|seo_truncate(65) %}

{% block seo %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="description" content="{{ seo_desc }}"/>
    <meta property="og:type" content="article"/>
    <meta property="og:url" content="{{ canonical_url }}"/>
    <meta property="og:title" content="{{ new.title }}"/>
    <meta property="og:description" content="{{ seo_desc }}"/>
    <meta property="og:image" content="{{ seo_image }}"/>
    <meta property="og:site_name" content="ADIVEC"/>
    {% if new.createdAt %}
        <meta property="article:published_time" content="{{ new.createdAt|date('c') }}"/>
    {% endif %}
{% endblock %}
{% block title %}{{ seo_title }}{% endblock %}
{# Suffixe « | ADIVEC » seulement s'il reste de la place (titres d'actualités souvent longs) #}
{% block title_suffix %}{% if seo_title|length <= 56 %} | ADIVEC{% endif %}{% endblock %}

{% block schema %}
    {{ parent() }}
    {% set ld_article = {
        '@context': 'https://schema.org',
        '@type': 'Article',
        'headline': new.title|seo_truncate(110),
        'url': canonical_url,
        'mainEntityOfPage': canonical_url,
        'image': seo_image,
        'description': seo_desc,
        'publisher': {'@type': 'Organization', 'name': 'ADIVEC', 'logo': {'@type': 'ImageObject', 'url': 'https://www.adivec.fr/img/logo_adivec.png'}},
        'author': {'@type': 'Organization', 'name': 'ADIVEC', 'url': 'https://www.adivec.fr'}
    } %}
    {# Dates : jamais de chaîne vide (schema invalide) — on omet le champ si la date est inconnue #}
    {% if new.createdAt %}
        {% set ld_article = ld_article|merge({
            'datePublished': new.createdAt|date('c'),
            'dateModified': (new.updatedAt ?? new.createdAt)|date('c')
        }) %}
    {% endif %}
    <script type="application/ld+json">{{ ld_article|json_encode(ld_flags)|raw }}</script>
    {% set ld_breadcrumb = {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        'itemListElement': [
            {'@type': 'ListItem', 'position': 1, 'name': 'Accueil', 'item': url('app_home')},
            {'@type': 'ListItem', 'position': 2, 'name': 'Actualités', 'item': url('app_news')},
            {'@type': 'ListItem', 'position': 3, 'name': new.title|seo_truncate(110), 'item': canonical_url}
        ]
    } %}
    <script type="application/ld+json">{{ ld_breadcrumb|json_encode(ld_flags)|raw }}</script>
{% endblock %}

{% block body %}
    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container text-center py-5">
            <p class="h1 display-3 text-white mb-4 animated slideInDown">News</p>
        </div>
    </div>
    <!-- Page Header End -->

    {# Mise en page « article + colonne latérale » : l'article à gauche, à droite (sous l'article
       sur mobile) les produits cités, l'appel à devis et les autres actualités. #}
    <div class="container pb-5 news-page">
        <nav class="article-breadcrumb" aria-label="Fil d’Ariane">
            <a href="{{ path('app_home') }}">Accueil</a><span aria-hidden="true">›</span><a href="{{ path('app_news') }}">Actualités</a><span aria-hidden="true">›</span><span aria-current="page">{{ new.title|seo_truncate(60) }}</span>
        </nav>

        <div class="row g-4 g-lg-5">
            <article class="col-lg-8">
                <span class="article-kicker">Actualité</span>
                <h1 class="article-title">{{ new.title }}</h1>
                <p class="article-meta mb-4">
                    {% if new.createdAt %}
                        <time datetime="{{ new.createdAt|date('Y-m-d') }}">Publié le {{ new.createdAt|date('d/m/Y') }}</time>
                        <span aria-hidden="true">·</span>
                    {% endif %}
                    <span>{{ new.description|reading_time }} min de lecture</span>
                </p>

                {% if new.image %}
                    <figure class="article-cover mb-5">
                        {# Image principale : pas de lazy-loading (visible dès l'arrivée sur la page) #}
                        <img src="{{ asset('uploads/images/blog/'~new.image) }}" {{ img_dims('uploads/images/blog/'~new.image) }}
                             alt="{{ new.title }}" fetchpriority="high">
                    </figure>
                {% endif %}

                {# news_html : le HTML de l'éditeur Trix (un bloc découpé par des <br>) est restructuré
                   en paragraphes, intertitres et listes — voir App\Service\NewsHtmlFormatter #}
                <div class="news-content">{{ new.description|news_html }}</div>

                <p class="mt-5 mb-0"><a class="article-back" href="{{ path('app_news') }}">← Toutes les actualités</a></p>
            </article>

            <aside class="col-lg-4">
                <div class="news-aside">
                    {% if new.relatedProducts is not empty %}
                        <section class="news-aside-box" aria-labelledby="produits-associes">
                            <h2 id="produits-associes" class="h5 mb-3">Produits cités</h2>
                            <ul class="list-unstyled d-grid gap-2 mb-0">
                                {% for product in new.relatedProducts %}
                                    {% set thumb = product.image
                                        ? 'uploads/images/products/' ~ product.image
                                        : 'uploads/images/family/' ~ product.type.family.image %}
                                    <li>
                                        <a class="product-chip" href="{{ path('app_product_page', {slug: product.slug}) }}">
                                            <img src="{{ asset(thumb) }}" alt="" width="56" height="56" loading="lazy">
                                            <span class="product-chip-name">{{ product.nom }}</span>
                                            <span class="product-chip-arrow" aria-hidden="true">→</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}

                    <section class="news-cta" aria-labelledby="news-cta-title">
                        <p id="news-cta-title" class="h5">Un projet de formulation ?</p>
                        <p>Nos équipes vous conseillent et vous envoient échantillons et fiches techniques.</p>
                        <a class="btn btn-primary rounded-pill px-4" href="{{ path('app_contact') }}">Demander un devis</a>
                    </section>

                    {% if other_news is not empty %}
                        <section class="mt-4" aria-labelledby="a-lire-aussi">
                            <h2 id="a-lire-aussi" class="h5 mb-3">À lire aussi</h2>
                            <ul class="list-unstyled mb-0">
                                {% for item in other_news %}
                                    <li class="mb-3">
                                        <a class="news-mini" href="{{ path('show_blog', {slug: item.slug}) }}">
                                            {% if item.image %}
                                                <img src="{{ asset('uploads/images/blog/'~item.image) }}" alt="" width="84" height="64" loading="lazy">
                                            {% endif %}
                                            <span>
                                                <span class="news-mini-title">{{ item.title }}</span>
                                                {% if item.createdAt %}<small>{{ item.createdAt|date('d/m/Y') }}</small>{% endif %}
                                            </span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}
                </div>
            </aside>
        </div>
    </div>
{% endblock %}
