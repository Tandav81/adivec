{# templates/admin/my-dashboard.html.twig #}
{% extends '@EasyAdmin/layout.html.twig' %}

{% block main %}
<div class="content-header">
    <div class="container-fluid">
        <h1 class="mb-4">Tableau de bord</h1>

        {# ── Cartes statistiques ────────────────────────────────── #}
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                            <i class="fa fa-eye fa-lg text-primary"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Visites aujourd'hui</div>
                            <div class="fs-3 fw-bold">{{ stats.today }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3">
                            <i class="fa fa-calendar-week fa-lg text-success"></i>
                        </div>
                        <div>
                            <div class="text-muted small">7 derniers jours</div>
                            <div class="fs-3 fw-bold">{{ stats.week }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                            <i class="fa fa-chart-line fa-lg text-warning"></i>
                        </div>
                        <div>
                            <div class="text-muted small">30 derniers jours</div>
                            <div class="fs-3 fw-bold">{{ stats.month }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-info bg-opacity-10 p-3">
                            <i class="fa fa-users fa-lg text-info"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Visiteurs uniques (30j)</div>
                            <div class="fs-3 fw-bold">{{ stats.uniqueVisitors }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Graphique + top pages ─────────────────────────────── #}
        <div class="row g-3">
            <div class="col-xl-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 pt-3">
                        <h5 class="mb-0">Visites des 30 derniers jours</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="visitsChart" height="100"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 pt-3">
                        <h5 class="mb-0">Pages les plus visitées <small class="text-muted fs-6">(30j)</small></h5>
                    </div>
                    <div class="card-body p-0">
                        {% if topPages is empty %}
                            <p class="text-muted p-3 mb-0">Aucune donnée pour le moment.</p>
                        {% else %}
                            <ul class="list-group list-group-flush">
                                {% for page in topPages %}
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-3">
                                        <span class="text-truncate me-2" style="max-width:75%" title="{{ page.url }}">
                                            {{ page.url }}
                                        </span>
                                        <span class="badge bg-primary rounded-pill">{{ page.total }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
(function () {
    const labels = {{ chartLabels | json_encode | raw }};
    const data   = {{ chartData   | json_encode | raw }};

    new Chart(document.getElementById('visitsChart'), {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Visites',
                data: data,
                borderColor: '#3b82f6',
                backgroundColor: 'rgba(59,130,246,0.08)',
                borderWidth: 2,
                pointRadius: 3,
                fill: true,
                tension: 0.3,
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { ticks: { maxTicksLimit: 10 } },
                y: { beginAtZero: true, ticks: { stepSize: 1 } }
            }
        }
    });
})();
</script>
{% endblock main %}
