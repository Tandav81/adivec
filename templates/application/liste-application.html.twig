{% extends 'base.html.twig' %}
{% block seo %}
    <link rel="canonical" href="https://www.adivec.fr/application">
    <meta name="description" content="Boulangerie, plats préparés, produits laitiers, cosmétique, peinture, textile… Trouvez les ingrédients naturels Adivec adaptés à votre application."/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="https://www.adivec.fr/application"/>
    <meta property="og:title" content="Applications de nos ingrédients naturels | ADIVEC"/>
    <meta property="og:description" content="Trouvez les ingrédients naturels Adivec adaptés à votre application : agroalimentaire, cosmétique, peintures, textile, papier…"/>
    <meta property="og:image" content="https://www.adivec.fr/img/logo_adivec.png"/>
    <meta property="og:site_name" content="ADIVEC"/>
{% endblock %}
{% block title %}Applications de nos ingrédients naturels{% endblock %}

{% block body %}
    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container text-center py-5">
            <h1 class="display-3 text-white mb-4 animated slideInDown">Nos applications</h1>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_familles') }}">Familles</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_application_page') }}">Applications</a></li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- Page Header End -->

    <!-- Applications Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center mx-auto wow fadeInUp mb-5" data-wow-delay="0.1s" style="max-width: 500px;">
                <p class="section-title bg-white text-center text-primary px-3">Nos applications</p>
            </div>
            <div class="row gx-4 d-flex justify-content-around">

                {% for application in applications %}

                    <div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.1s">
                        <a class="d-block h5" href="{{ path('app_application', {'slug': application.slug}) }}">
                            <div class="product-item">
                                <div class="position-relative famille image">
                                    <img class="img-fluid image-height"
                                         src="{{ asset('uploads/images/application/'~application.image) }}" {{ img_dims('uploads/images/application/'~application.image) }}
                                         alt="image {{ application.libelle }}"
                                         loading="lazy">
                                </div>
                                <div class="text-center p-4">
                                    <span>{{ application.libelle }}</span>
                                </div>
                            </div>
                        </a>
                    </div>

                {% endfor %}

            </div>
        </div>
    </div>
    <!-- Applications End -->
{% endblock %}