<h1>Demande client</h1>

<h3>Un client voudrait être recontacté!</h3>

<p><strong>Voici ces informations : </strong></p>
<p>Compagnie : {{ formdata.company }}</p>
<p>Code Postal : {{ formdata.codePostal }}</p>
<p>Nom : {{ formdata.nom }}</p>
<p>Email : {{ formdata.email }}</p>
<p>Téléphone : {{ formdata.numTel }}</p>
{% if formdata.produit ?? false %}<p>Produit concerné : {{ formdata.produit }}</p>{% endif %}
{% if formdata.quantite ?? false %}<p>Quantité souhaitée : {{ formdata.quantite }}</p>{% endif %}

<h3>Message du client:</h3>

<p>{{ formdata.message }}</p>