{% extends 'base.html.twig' %}
{% block seo %}
    <link rel="canonical" href="https://www.adivec.fr/familles">
    <meta name="description" content="Découvrez toutes les familles d'ingrédients naturels distribués par Adivec : amidons, gommes, fibres, protéines, colorants, lécithines et bien d'autres."/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="https://www.adivec.fr/familles"/>
    <meta property="og:title" content="Nos familles d'ingrédients naturels | ADIVEC"/>
    <meta property="og:description" content="Amidons, gommes, fibres, protéines, colorants naturels, lécithines... Découvrez le catalogue complet d'ingrédients naturels distribués par Adivec."/>
    <meta property="og:image" content="https://www.adivec.fr/img/logo_adivec.png"/>
    <meta property="og:site_name" content="ADIVEC"/>
{% endblock %}
{% block title %}Nos familles d'ingrédients naturels{% endblock %}

{% block body %}
    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container text-center py-5">
            <p class="h1 display-3 text-white mb-4 animated slideInDown">Nos familles</p>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- Page Header End -->

    <!-- Product Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center mx-auto wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
                <p class="section-title bg-white text-center text-primary px-3">Nos familles de produits</p>
                <h1 class="mb-5">Nos familles d'ingrédients naturels</h1>
            </div>
            <div class="row gx-4 d-flex justify-content-around">

                {% for family in families %}
                    <div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.1s">
                        <a class="d-block h5" href="{{ path('app_types_family', {'slug': family.slug}) }}" title="{{ family.name }}">
                            <div class="product-item">
                                <div class="position-relative famille image">
                                    <img class="img-fluid image-height" src="{{ asset('uploads/images/family/'~family.image) }}" {{ img_dims('uploads/images/family/'~family.image) }}
                                         alt="{{ family.name }}" loading="lazy">
                                </div>
                                <div class="text-center p-4">
                                    <span class="d-block h5">{{ family.name }}</span>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}

            </div>
        </div>
    </div>
    <!-- Product End -->

{% endblock %}
