{% extends 'base.html.twig' %}
{% block seo %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="description" content="{{ new.description | striptags | u.truncate(155, '...') }}"/>
    <meta property="og:type" content="article"/>
    <meta property="og:url" content="{{ canonical_url }}"/>
    <meta property="og:title" content="{{ new.title }} | ADIVEC"/>
    <meta property="og:description" content="{{ new.description | striptags | u.truncate(155, '...') }}"/>
    <meta property="og:image" content="https://www.adivec.fr/uploads/images/blog/{{ new.image }}"/>
    <meta property="og:site_name" content="ADIVEC"/>
{% endblock %}
{% block title %}{{ new.title }}{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ new.title }}",
  "url": "{{ canonical_url }}",
  "image": "https://www.adivec.fr/uploads/images/blog/{{ new.image }}",
  "description": "{{ new.description | striptags | u.truncate(155, '...') }}",
  "publisher": {
    "@type": "Organization",
    "name": "ADIVEC",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.adivec.fr/img/logo_adivec.png"
    }
  },
  "author": {
    "@type": "Organization",
    "name": "ADIVEC"
  },
  "datePublished": "{{ new.createdAt ? new.createdAt|date('Y-m-d') : '' }}",
  "dateModified": "{{ new.updatedAt ? new.updatedAt|date('Y-m-d') : (new.createdAt ? new.createdAt|date('Y-m-d') : '') }}"
}
</script>
{% endblock %}

{% block body %}
    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container text-center py-5">
            <p class="display-3 text-white mb-4 animated slideInDown fw-bold">News</p>
        </div>
    </div>
    <!-- Page Header End -->


    <!-- Service Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center mx-auto pb-4 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
                <p class="section-title bg-white text-center text-primary px-3">News</p>
                <h1 class="mb-5">{{ new.title }}</h1>
            </div>
            <div class="row gy-5 gx-4">
                {% if new.image %}
                <div class="col-auto">
                    <div class="service-img">
                        <img class="img-fluid" src="{{ asset('uploads/images/blog/'~new.image) }}"
                             alt="{{ new.title }}" loading="lazy">
                    </div>
                </div>
                {% endif %}
                <div class="col-lg-9 col-md-6 pt-5 ">
                    {# .news-content : conteneur bloc (pas de <p>) pour accepter les titres/listes générés par l'éditeur #}
                    <div class="service-item h-100">
                        <div class="news-content mb-4">{{ new.description|raw }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Service End -->

{% endblock %}
