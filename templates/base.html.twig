{% import 'partials/_icons.html.twig' as icons %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
    <meta name="author" content="Adivec"/>

    {% block seo %}
        <meta name="description"
              content="ADIVEC est une société de représentation et de négoce spécialisée dans les dérivés de produits agricoles et les matières premières naturelles."/>
    {% endblock %}
    {# Twitter / X : reprend og:title, og:description et og:image de chaque page #}
    <meta name="twitter:card" content="summary_large_image"/>

    <title>{% block title %}ADIVEC – Ingrédients naturels pour l'industrie{% endblock %}{% block title_suffix %} | ADIVEC{% endblock %}</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="{{ asset('img/logo_adivec_seul.png') }}"/>
    {% block stylesheets %}
        <!-- Google Fonts async (non-bloquant) -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Open+Sans:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
        <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Open+Sans:wght@400;500;600&display=swap"></noscript>

        <!-- Icônes : SVG inline via templates/partials/_icons.html.twig (plus aucune police d'icônes à charger) -->

        <!-- Libraries Stylesheet -->
        <link href="{{ asset('lib/animate/animate.min.css') }}" rel="stylesheet">

        <!-- Customized Bootstrap Stylesheet -->
        <link href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet">
        <!-- Core theme CSS (includes Bootstrap)-->
        <link href="{{ asset('css/style.css') }}" rel="stylesheet"/>
    {% endblock %}

    {% block schema %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "ADIVEC",
      "url": "https://www.adivec.fr",
      "logo": "https://www.adivec.fr/img/logo_adivec.png",
      "description": "Société de représentation et de négoce spécialisée dans les ingrédients d'origine naturelle pour l'industrie agroalimentaire et technique.",
      "foundingDate": "1989",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "10 bis rue de Lahire",
        "addressLocality": "Orléans",
        "postalCode": "45000",
        "addressCountry": "FR"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+33-2-38-24-15-50",
        "contactType": "customer service",
        "email": "contact@adivec.fr",
        "availableLanguage": "French",
        "hoursAvailable": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "08:00",
          "closes": "18:00"
        }
      },
      "sameAs": [
        "https://www.linkedin.com/company/adivec/"
      ]
    }
    </script>
    {% endblock %}

    {% block javascripts %}
        <!-- JavaScript Libraries -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" defer></script>
        <script src="{{ asset('js/bootstrap.bundle.js') }}" defer></script>
        <script src="{{ asset('lib/wow/wow.min.js') }}" defer></script>
        {# easing, waypoints, counterup, owlcarousel, lightbox retirés (01/10/2026) : aucun élément ne les utilisait #}
        <script src="{{ asset('lib/parallax/parallax.min.js') }}" defer></script>

        <!-- Template Javascript -->
        <script src="{{ asset('js/main.js') }}" defer></script>
        <script src="{{ asset('js/tools/search.js') }}" defer></script>

    {% endblock %}
</head>
<body id="page-top">


<!-- Topbar Start -->
<div class="container-fluid px-0 topbar">
    <div class="row g-0 d-none d-lg-flex">
        <div class="col-lg-6 ps-5 text-start">
            <div class="h-100 d-inline-flex align-items-center text-light">
                <span>Suivez-nous:</span>
                <a class="btn btn-link text-light"
                   href="https://www.linkedin.com/company/adivec/?originalSubdomain=fr"
                   target="_blank"
                   title="lien linkedin Adivec">
                    {{ icons.icon('linkedin', '', '1em', 'Adivec sur LinkedIn') }}
                </a>
            </div>
        </div>
        <div class="col-lg-6 text-end">
            <div class="h-100 d-inline-flex align-items-center text-dark py-2 px-4 phone">
                <span class="me-2 fw-semi-bold">{{ icons.icon('phone', 'me-2') }}Appelez-nous:</span>
                <a href="tel:+33238241550" title="numéro de téléphone Adivec">02 38 24 15 50</a>
            </div>
        </div>
    </div>
</div>
<!-- Topbar End -->


<!-- Navbar Start -->
<nav class="navbar navbar-expand-lg bg-white navbar-light sticky-top px-4 px-lg-5">
    <a href="{{ path('app_home') }}" class="navbar-brand d-flex align-items-center" title="lien page accueil">
        <img class="img-fluid" src="{{ asset('img/logo_adivec.png') }}" alt="logo Adivec" width="324" height="102">
    </a>

    <button type="button" class="navbar-toggler me-0" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
            aria-controls="navbarCollapse" aria-expanded="false" aria-label="Ouvrir le menu de navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarCollapse">
        <div class="navbar-nav ms-auto p-4 p-lg-0">
            <a href="{{ path('app_about') }}" class="nav-item nav-link">Nous Découvrir</a>
            <a href="{{ path('app_news') }}" class="nav-item nav-link">Nos News</a>
            <a href="{{ path('app_familles') }}" class="nav-item nav-link">Nos Produits</a>
            <a href="{{ path('app_application_page') }}" class="nav-item nav-link">Nos Applications</a>
            <a href="{{ path('app_contact') }}" class="nav-item nav-link">Contactez-nous</a>
        </div>
    </div>
    <div class="container-search">
        <div class="position-relative">
            <input type="text"
                   class="form-control rounded-pill search-bar pe-5"
                   placeholder="Rechercher un produit ou une application..."
                   aria-label="Rechercher un produit ou une application"
                   id="searchInput">
            <span class="position-absolute top-50 translate-middle-y loupe-right">
                    {{ icons.icon('search') }}
                </span>
            <ul id="autocompleteResults" class="autocomplete-results"></ul>
        </div>
    </div>
</nav>
<div class="col position-absolute">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
</div>
<!-- Navbar End -->
{% block body %}

{% endblock %}
<!-- Footer Start -->
<div class="container-fluid footer mt-5 py-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-lg-3 col-md-6">
                <p class="h5 text-white mb-4">Notre bureau</p>
                <p class="mb-2">
                    <a href="https://maps.app.goo.gl/bdN2JzJaGxAWqyRu9" target="_blank" rel="noopener">
                        {{ icons.icon('map-marker', 'me-3') }}
                        10 bis rue de Lahire
                        <span class="d-block align-adress">45000 Orléans</span>
                    </a>
                </p>
                <p class="mb-2">{{ icons.icon('phone', 'me-3') }}<a href="tel:+33238241550">02 38 24 15 50</a></p>
                <p class="mb-2">{{ icons.icon('envelope', 'me-3') }}<a href="mailto:contact@adivec.fr">contact@adivec.fr</a>
                </p>
                <div class="d-flex pt-3">
                    <a class="btn btn-square rounded-circle me-2"
                       target="_blank"
                       rel="noopener"
                       title="lien linkedin Adivec"
                       href="https://www.linkedin.com/company/adivec/?originalSubdomain=fr">{{ icons.icon('linkedin', '', '1em', 'Adivec sur LinkedIn') }}</a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <p class="h5 text-white mb-4">Liens rapides</p>
                <a class="btn btn-link" href="{{ path('app_about') }}">Découvrir</a>
                <a class="btn btn-link" href="{{ path('app_contact') }}">Nous contacter</a>
                <a class="btn btn-link" href="{{ path('app_news') }}">Nos news</a>
                <a class="btn btn-link" href="{{ path('app_legal') }}">Mentions légales</a>
                <a class="btn btn-link" href="{{ path('app_cgv') }}">CGV</a>
            </div>
            <div class="col-lg-3 col-md-6">
                <p class="h5 text-white mb-4">Heures d'ouverture</p>
                <p class="mb-1">Lundi - Vendredi</p>
                <p class="h6 text-light">08:00 - 18:00</p>
            </div>
        </div>
    </div>
</div>
<!-- Footer End -->


<!-- Copyright Start -->
<div class="container-fluid text-body copyright py-4">
    <div class="container">
        <div class="row">
            <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                &copy; <a class="fw-semi-bold" href="https://www.adivec.fr">Adivec</a>, All Right Reserved.
            </div>
            <div class="col-md-6 text-center text-md-end">
                <!--/*** This template is free as long as you keep the footer author’s credit link/attribution link/backlink. If you'd like to use the template without the footer author’s credit link/attribution link/backlink, you can purchase the Credit Removal License from "https://htmlcodex.com/credit-removal". Thank you for your support. ***/-->
                Designed By <a class="fw-semi-bold" href="https://htmlcodex.com">HTML Codex</a> Distributed By <a
                        href="https://themewagon.com">ThemeWagon</a>
            </div>
        </div>
    </div>
</div>
<!-- Copyright End -->


<!-- Back to Top -->
<a href="#" class="btn btn-lg btn-primary btn-lg-square rounded-circle back-to-top" title="Back to Top">{{ icons.icon('arrow-up') }}</a>


</body>
</html>
