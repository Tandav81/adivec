{% extends 'base.html.twig' %}
{% block seo %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="description"
          content="{{ product.description ? product.description|striptags|u.truncate(155, '...') : 'Découvrez ' ~ product.nom ~ ', un ingrédient naturel distribué par Adivec. Contactez-nous pour un devis.' }}"/>
    <meta property="og:type" content="product"/>
    <meta property="og:url" content="{{ canonical_url }}"/>
    <meta property="og:title" content="{{ product.nom }} | ADIVEC"/>
    <meta property="og:description"
          content="Découvrez {{ product.nom }}, un ingrédient naturel distribué par Adivec. Applications : {% for app in product.applications %}{{ app.libelle }}{% if not loop.last %}, {% endif %}{% endfor %}."/>
    {% if product.image %}
        <meta property="og:image" content="https://www.adivec.fr/uploads/images/products/{{ product.image }}"/>
    {% else %}
        <meta property="og:image"
              content="https://www.adivec.fr/uploads/images/family/{{ product.type.family.image }}"/>
    {% endif %}
    <meta property="og:site_name" content="ADIVEC"/>
{% endblock %}
{% block title %}{{ product.nom }}{% endblock %}

{% block schema %}
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Accueil",
              "item": "https://www.adivec.fr"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "{{ product.type.family.name }}",
      "item": "https://www.adivec.fr/types/{{ product.type.family.slug }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ product.type.name }}",
      "item": "https://www.adivec.fr/products/{{ product.type.slug }}"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "{{ product.nom }}",
      "item": "{{ canonical_url }}"
    }
  ]
}
    </script>
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Product",
          "name": "{{ product.nom }}",
          "url": "{{ canonical_url }}",
          {% if product.image %}
          "image": "https://www.adivec.fr/uploads/images/products/{{ product.image }}",
          {% else %}
          "image": "https://www.adivec.fr/uploads/images/family/{{ product.type.family.image }}",
          {% endif %}
          "category": "{{ product.type.family.name }}",
          "brand": {
            "@type": "Brand",
            "name": "ADIVEC"
          }
        }
    </script>
{% endblock %}

{% block body %}
    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container text-center py-5">
            <p class="display-3 text-white mb-4 animated slideInDown fw-bold">{{ product.type.name }}</p>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item"><a
                                href="{{ path('app_types_family', { 'slug' : product.type.family.slug }) }}">{{ product.type.family.name }}</a>
                    </li>
                    <li class="breadcrumb-item"><a
                                href="{{ path('app_products_type', { 'slug' : product.type.slug }) }}">{{ product.type.name }}</a>
                    </li>
                </ol>
            </nav>

        </div>
    </div>
    <!-- Page Header End -->


    <!-- Service Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="pb-4 wow fadeInUp d-flex fiche-produit" data-wow-delay="0.1s">
                <div class="col-auto" style="max-width: 50%">
                    {% if product.image %}
                        <img class="img-fluid"
                             src="{{ asset('uploads/images/products/'~product.image) }}"
                             alt="{{ product.nom }}" loading="lazy">
                    {% else %}
                        <img class="img-fluid"
                             src="{{ asset('uploads/images/family/'~product.type.family.image) }}"
                             alt="{{ product.type.family.name }}" loading="lazy">
                    {% endif %}
                </div>

                <div class="texte-produit">
                    <div class="d-flex app-rows mb-4 mt-2">
                        <div>
                            <h1 class="mb-5" style="max-width: 800px;">{{ product.nom }}</h1>
                        </div>
                        <div>
                            <h2>Applications</h2>
                        </div>

                        <div>
                            {% for application in product.applications %}
                                <a href="{{ path('app_application', {'slug': application.slug}) }}"
                                   class="btn rounded-pill animated slideInRight" style="width: 100%;"
                                   title="{{ application.libelle }}">
                                    <div class="app-pills d-flex">
                                        <div>
                                            <img class="img-fluid mb-2"
                                                 src="{{ asset('uploads/images/application/icone/'~application.icone) }}"
                                                 alt="icone {{ application.libelle }}" style="width: 30px" loading="lazy">
                                        </div>
                                        <div>
                                            <p class="libelle-application">{{ application.libelle }}</p>
                                        </div>
                                    </div>
                                </a>
                            {% endfor %}
                        </div>

                    </div>

                    {% if product.description %}
                        <div class="product-description mt-3 mb-4">
                            <h2>Description</h2>
                            <p>{{ product.description }}</p>
                        </div>
                    {% endif %}

                    <h2>Packagings</h2>
                    {% for packaging in product.packagings %}
                        <div class="d-flex">
                            <p class="mb-4">{{ packaging }}</p>
                        </div>
                    {% endfor %}

                    <div>
                        {% if product.fournisseur.logo %}
                            <img class="img-fluid animated infinite logos"
                                 src="{{ asset('uploads/images/logos/'~product.fournisseur.logo) }}"
                                 alt="logos partenaire {{ product.fournisseur.name }}" loading="lazy">
                        {% endif %}
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!-- Service End -->
{% endblock %}
